{
  "name": "magpie-image-budget",
  "version": "0.1.1",
  "description": "magpie gateway middleware: keep only the newest N base64 images in a request, older ones become placeholder text",
  "type": "module",
  "files": ["image-budget.middleware.js", "README.md", "cases.json"],
  "keywords": ["magpie", "magpie-middleware", "opencode", "opencode-plugin", "image-budget", "llm-gateway"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/famiji/magpie-image-budget.git"
  },
  "scripts": {
    "test": "bun test"
  },
  "magpie": {
    "middleware": "./image-budget.middleware.js",
    "options": {
      "keep": 10,
      "placeholder": "[older image omitted by image-budget]"
    }
  }
}
